@startuml UseCase_Overview
!theme plain
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecaseBorderColor #2C3E50
skinparam usecaseBackgroundColor #ECF0F1
skinparam actorBorderColor #2C3E50
skinparam actorFontSize 13
skinparam usecaseFontSize 12
skinparam ArrowColor #2C3E50

title Sơ đồ Use Case Tổng Thể\nComputer Components Shop with AI Integration

' ===== ACTORS =====
actor "Guest" as Guest #lightblue
actor "User" as User #lightgreen
actor "Admin" as Admin #lightyellow
actor "Gemini AI" as GeminiAI #lightpink

' Kế thừa actor
Guest <|-- User
User  <|-- Admin

' ===== PACKAGES =====
package "Xem sản phẩm" {
  usecase "Xem danh sách sản phẩm" as UC_ViewProducts
  usecase "Tìm kiếm sản phẩm" as UC_SearchProducts
  usecase "Lọc sản phẩm\n(category, giá)" as UC_FilterProducts
  usecase "Xem chi tiết sản phẩm" as UC_ViewProductDetail
}

package "Xác thực" {
  usecase "Đăng ký tài khoản" as UC_Register
  usecase "Đăng nhập" as UC_Login
  usecase "Đăng xuất" as UC_Logout
}

package "Giỏ hàng & Đặt hàng" {
  usecase "Xem giỏ hàng" as UC_ViewCart
  usecase "Thêm vào giỏ hàng" as UC_AddToCart
  usecase "Cập nhật số lượng\ntrong giỏ" as UC_UpdateCart
  usecase "Xóa khỏi giỏ hàng" as UC_RemoveFromCart
  usecase "Đặt hàng (COD)" as UC_PlaceOrder
  usecase "Xem lịch sử đơn hàng" as UC_ViewOrders
  usecase "Xem chi tiết đơn hàng" as UC_ViewOrderDetail
  usecase "Hủy đơn hàng" as UC_CancelOrder
}

package "Chatbot AI" {
  usecase "Gửi tin nhắn\ncho chatbot" as UC_Chat
  usecase "Hỏi về chính sách shop\n(RAG)" as UC_AskPolicy
  usecase "Yêu cầu gợi ý\ncấu hình PC" as UC_AskPCConfig
}

package "Quản lý sản phẩm (Admin)" {
  usecase "Thêm sản phẩm mới" as UC_CreateProduct
  usecase "Cập nhật sản phẩm" as UC_UpdateProduct
  usecase "Xóa sản phẩm\n(soft delete)" as UC_DeleteProduct
  usecase "Upload ảnh sản phẩm" as UC_UploadImage
}

package "Quản lý đơn hàng (Admin)" {
  usecase "Xem tất cả đơn hàng" as UC_AdminViewOrders
  usecase "Cập nhật trạng thái\nđơn hàng" as UC_UpdateOrderStatus
}

package "Quản lý PC Case (Admin)" {
  usecase "Xem danh sách PC Case" as UC_ViewPCCases
  usecase "Tạo PC Case mới" as UC_CreatePCCase
  usecase "Kiểm tra ràng buộc\ntương thích" as UC_CheckCompatibility
  usecase "Cập nhật PC Case" as UC_UpdatePCCase
  usecase "Xóa PC Case" as UC_DeletePCCase
}

package "Quản lý tài liệu RAG (Admin)" {
  usecase "Upload tài liệu RAG\n(PDF/DOCX/TXT)" as UC_UploadRAG
  usecase "Xem danh sách\ntài liệu RAG" as UC_ViewRAGDocs
  usecase "Xóa tài liệu RAG" as UC_DeleteRAGDocs
}

' ===== GUEST ASSOCIATIONS =====
Guest --> UC_ViewProducts
Guest --> UC_SearchProducts
Guest --> UC_FilterProducts
Guest --> UC_ViewProductDetail
Guest --> UC_Register
Guest --> UC_Login
Guest --> UC_Chat

' ===== USER ASSOCIATIONS (thêm vào quyền Guest) =====
User --> UC_Logout
User --> UC_ViewCart
User --> UC_AddToCart
User --> UC_UpdateCart
User --> UC_RemoveFromCart
User --> UC_PlaceOrder
User --> UC_ViewOrders
User --> UC_ViewOrderDetail
User --> UC_CancelOrder

' ===== ADMIN ASSOCIATIONS (thêm vào quyền User) =====
Admin --> UC_CreateProduct
Admin --> UC_UpdateProduct
Admin --> UC_DeleteProduct
Admin --> UC_UploadImage
Admin --> UC_AdminViewOrders
Admin --> UC_UpdateOrderStatus
Admin --> UC_ViewPCCases
Admin --> UC_CreatePCCase
Admin --> UC_UpdatePCCase
Admin --> UC_DeletePCCase
Admin --> UC_UploadRAG
Admin --> UC_ViewRAGDocs
Admin --> UC_DeleteRAGDocs

' ===== INCLUDE / EXTEND =====
UC_Chat ..> UC_AskPolicy    : <>
UC_Chat ..> UC_AskPCConfig  : <>

UC_CreateProduct ..> UC_UploadImage : <>
UC_UpdateProduct ..> UC_UploadImage : <>

UC_SearchProducts ..> UC_FilterProducts : <>

UC_CreatePCCase ..> UC_CheckCompatibility : <>
UC_UpdatePCCase ..> UC_CheckCompatibility : <>

UC_PlaceOrder ..> UC_ViewCart : <>

' ===== GEMINI AI =====
GeminiAI --> UC_AskPolicy
GeminiAI --> UC_AskPCConfig

@enduml
