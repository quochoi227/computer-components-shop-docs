erDiagram

    %% =====================================================================
    %% USERS
    %% =====================================================================
    users {
        UUID id PK
        VARCHAR email UK
        VARCHAR password_hash
        VARCHAR full_name
        VARCHAR phone
        TEXT address
        ENUM role "USER | ADMIN"
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    %% =====================================================================
    %% PRODUCTS
    %% =====================================================================
    products {
        UUID id PK
        VARCHAR name
        DECIMAL price
        INT stock_quantity
        ENUM category "CPU | MAINBOARD | RAM | GPU | STORAGE | PSU | CASE | CPU_COOLER"
        TEXT description
        JSONB detail
        BOOLEAN is_active
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    %% =====================================================================
    %% PRODUCT IMAGES
    %% =====================================================================
    product_images {
        UUID id PK
        UUID product_id FK
        VARCHAR image_url
        BOOLEAN is_primary "anh dai dien"
        INT display_order "thu tu hien thi"
        TIMESTAMP created_at
    }

    %% =====================================================================
    %% ORDERS
    %% =====================================================================
    orders {
        UUID id PK
        UUID user_id FK
        ENUM status "PENDING | CONFIRMED | SHIPPING | DELIVERED | CANCELLED"
        ENUM payment_method "COD"
        TEXT shipping_address
        DECIMAL total_amount
        TEXT note
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    %% =====================================================================
    %% ORDER ITEMS
    %% Phuong an B: product_id va pc_case_id deu nullable
    %% CHECK: dung mot trong hai phai non-null
    %% =====================================================================
    order_items {
        UUID id PK
        UUID order_id FK
        UUID product_id FK "nullable"
        UUID pc_case_id FK "nullable"
        INT quantity
        DECIMAL unit_price
    }

    %% =====================================================================
    %% CART ITEMS
    %% Phuong an B: product_id va pc_case_id deu nullable
    %% CHECK: dung mot trong hai phai non-null
    %% UNIQUE(user_id, product_id) va UNIQUE(user_id, pc_case_id)
    %% =====================================================================
    cart_items {
        UUID id PK
        UUID user_id FK
        UUID product_id FK "nullable"
        UUID pc_case_id FK "nullable"
        INT quantity
    }

    %% =====================================================================
    %% REVIEWS (gop product_reviews + pc_case_reviews)
    %% Phuong an B: product_id va pc_case_id deu nullable
    %% CHECK: dung mot trong hai phai non-null
    %% UNIQUE(user_id, product_id) va UNIQUE(user_id, pc_case_id)
    %% =====================================================================
    reviews {
        UUID id PK
        UUID user_id FK
        UUID product_id FK "nullable"
        UUID pc_case_id FK "nullable"
        SMALLINT rating "1-5"
        TEXT comment
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    %% =====================================================================
    %% PC CASES
    %% =====================================================================
    pc_cases {
        UUID id PK
        VARCHAR name
        VARCHAR use_case "gaming | study | office | rendering"
        DECIMAL total_price
        TEXT description
        BOOLEAN is_active
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    %% =====================================================================
    %% PC CASE ITEMS — thanh phan linh kien cua PC Case
    %% =====================================================================
    pc_case_items {
        UUID id PK
        UUID pc_case_id FK
        UUID product_id FK
        ENUM category "CPU | MAINBOARD | RAM | GPU | STORAGE | PSU | CASE | CPU_COOLER"
    }

    %% =====================================================================
    %% RAG DOCUMENTS
    %% =====================================================================
    rag_documents {
        UUID id PK
        VARCHAR title
        VARCHAR source_file
        TIMESTAMP created_at
    }

    %% =====================================================================
    %% RAG CHUNKS
    %% =====================================================================
    rag_chunks {
        UUID id PK
        UUID document_id FK
        TEXT content
        VECTOR embedding "dim=768"
        TIMESTAMP created_at
    }

    %% =====================================================================
    %% REFRESH TOKENS
    %% =====================================================================
    refresh_tokens {
        UUID id PK
        UUID user_id FK
        VARCHAR token UK
        TIMESTAMP expires_at
        BOOLEAN revoked "mac dinh FALSE"
        TIMESTAMP created_at
    }

    %% =====================================================================
    %% EMAIL VERIFICATION TOKENS
    %% =====================================================================
    email_verification_tokens {
        UUID id PK
        UUID user_id FK
        VARCHAR token UK
        TIMESTAMP expires_at
        BOOLEAN used
        TIMESTAMP created_at
    }

    %% =====================================================================
    %% PASSWORD RESET TOKENS
    %% =====================================================================
    password_reset_tokens {
        UUID id PK
        UUID user_id FK
        VARCHAR token UK
        TIMESTAMP expires_at
        BOOLEAN used
        TIMESTAMP created_at
    }

    %% =====================================================================
    %% RELATIONSHIPS
    %% =====================================================================

    %% --- Orders ---
    users ||--o{ orders : "places"
    orders ||--o{ order_items : "contains"

    %% order_items tham chieu toi product hoac pc_case (chi mot trong hai)
    products ||--o{ order_items : "ordered as product"
    pc_cases ||--o{ order_items : "ordered as pc case"

    %% --- Product Images ---
    products ||--|{ product_images : "has images"

    %% --- Cart ---
    users ||--o{ cart_items : "has in cart"

    %% cart_items tham chieu toi product hoac pc_case (chi mot trong hai)
    products ||--o{ cart_items : "added to cart as product"
    pc_cases ||--o{ cart_items : "added to cart as pc case"

    %% --- Reviews ---
    users ||--o{ reviews : "writes"

    %% reviews tham chieu toi product hoac pc_case (chi mot trong hai)
    products ||--o{ reviews : "reviewed as product"
    pc_cases ||--o{ reviews : "reviewed as pc case"

    %% --- PC Case composition ---
    pc_cases ||--|{ pc_case_items : "assembled from"
    products ||--o{ pc_case_items : "used in"

    %% --- RAG ---
    rag_documents ||--|{ rag_chunks : "split into"

    %% --- Auth tokens ---
    users ||--o{ refresh_tokens : "authenticated with"
    users ||--o{ email_verification_tokens : "verifies with"
    users ||--o{ password_reset_tokens : "resets password with"
