erDiagram

    %% =====================================================================
    %% USERS
    %% =====================================================================
    users {
        UUID id PK
        VARCHAR email UK
        VARCHAR password_hash
        VARCHAR full_name
        VARCHAR phone
        TEXT address
        ENUM role "USER | ADMIN"
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    %% =====================================================================
    %% PRODUCTS
    %% =====================================================================
    products {
        UUID id PK
        VARCHAR name
        DECIMAL price
        INT stock_quantity
        ENUM category "CPU | MAINBOARD | RAM | GPU | STORAGE | PSU | CASE | CPU_COOLER"
        VARCHAR image_url
        TEXT description
        JSONB detail
        BOOLEAN is_active
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    %% =====================================================================
    %% ORDERS
    %% =====================================================================
    orders {
        UUID id PK
        UUID user_id FK
        ENUM status "PENDING | CONFIRMED | SHIPPING | DELIVERED | CANCELLED"
        ENUM payment_method "COD"
        TEXT shipping_address
        DECIMAL total_amount
        TEXT note
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    %% =====================================================================
    %% ORDER ITEMS — san pham linh kien trong don hang
    %% =====================================================================
    order_items {
        UUID id PK
        UUID order_id FK
        UUID product_id FK
        INT quantity
        DECIMAL unit_price
    }

    %% =====================================================================
    %% PC CASE ORDER ITEMS — cau hinh PC trong don hang
    %% =====================================================================
    pc_case_order_items {
        UUID id PK
        UUID order_id FK
        UUID pc_case_id FK
        INT quantity
        DECIMAL unit_price "Gia PC Case tai thoi diem dat hang"
    }

    %% =====================================================================
    %% CART ITEMS — gio hang linh kien
    %% =====================================================================
    cart_items {
        UUID id PK
        UUID user_id FK
        UUID product_id FK
        INT quantity
    }

    %% =====================================================================
    %% PC CASE CART ITEMS — gio hang cau hinh PC
    %% =====================================================================
    pc_case_cart_items {
        UUID id PK
        UUID user_id FK
        UUID pc_case_id FK
        INT quantity
    }

    %% =====================================================================
    %% PRODUCT REVIEWS — danh gia linh kien
    %% =====================================================================
    product_reviews {
        UUID id PK
        UUID user_id FK
        UUID product_id FK
        SMALLINT rating "1-5"
        TEXT comment
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    %% =====================================================================
    %% PC CASE REVIEWS — danh gia cau hinh PC
    %% =====================================================================
    pc_case_reviews {
        UUID id PK
        UUID user_id FK
        UUID pc_case_id FK
        SMALLINT rating "1-5"
        TEXT comment
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    %% =====================================================================
    %% PC CASES
    %% =====================================================================
    pc_cases {
        UUID id PK
        VARCHAR name
        VARCHAR use_case "gaming | study | office | rendering"
        DECIMAL total_price
        TEXT description
        BOOLEAN is_active
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    %% =====================================================================
    %% PC CASE ITEMS — thanh phan linh kien cua PC Case
    %% =====================================================================
    pc_case_items {
        UUID id PK
        UUID pc_case_id FK
        UUID product_id FK
        ENUM category "CPU | MAINBOARD | RAM | GPU | STORAGE | PSU | CASE | CPU_COOLER"
    }

    %% =====================================================================
    %% RAG DOCUMENTS
    %% =====================================================================
    rag_documents {
        UUID id PK
        VARCHAR title
        VARCHAR source_file
        TIMESTAMP created_at
    }

    %% =====================================================================
    %% RAG CHUNKS
    %% =====================================================================
    rag_chunks {
        UUID id PK
        UUID document_id FK
        TEXT content
        VECTOR embedding "dim=768"
        TIMESTAMP created_at
    }

    %% =====================================================================
    %% RELATIONSHIPS
    %% =====================================================================

    %% --- Orders ---
    %% User dat nhieu don hang
    users ||--o{ orders : "places"

    %% Don hang chua linh kien rieng le
    orders ||--o{ order_items : "contains product"

    %% Don hang chua cau hinh PC
    orders ||--o{ pc_case_order_items : "contains pc case"

    %% Linh kien xuat hien trong nhieu dong don hang
    products ||--o{ order_items : "included in"

    %% PC Case xuat hien trong nhieu dong don hang
    pc_cases ||--o{ pc_case_order_items : "included in"

    %% --- Cart ---
    %% User co nhieu linh kien trong gio
    users ||--o{ cart_items : "adds product to cart"

    %% User co nhieu cau hinh PC trong gio
    users ||--o{ pc_case_cart_items : "adds pc case to cart"

    %% Linh kien nam trong nhieu gio hang
    products ||--o{ cart_items : "added to cart"

    %% PC Case nam trong nhieu gio hang
    pc_cases ||--o{ pc_case_cart_items : "added to cart"

    %% --- Reviews ---
    %% User danh gia linh kien
    users ||--o{ product_reviews : "reviews product"

    %% User danh gia cau hinh PC
    users ||--o{ pc_case_reviews : "reviews pc case"

    %% Linh kien nhan nhieu danh gia
    products ||--o{ product_reviews : "receives review"

    %% PC Case nhan nhieu danh gia
    pc_cases ||--o{ pc_case_reviews : "receives review"

    %% --- PC Case composition ---
    %% PC Case gom nhieu linh kien
    pc_cases ||--|{ pc_case_items : "assembled from"

    %% Linh kien duoc dung trong nhieu PC Case
    products ||--o{ pc_case_items : "used in"

    %% --- RAG ---
    %% Tai lieu chia thanh nhieu chunk
    rag_documents ||--|{ rag_chunks : "split into"

    %% =====================================================================
    %% EMAIL VERIFICATION TOKENS
    %% =====================================================================
    email_verification_tokens {
        UUID id PK
        UUID user_id FK
        VARCHAR token UK
        TIMESTAMP expires_at
        BOOLEAN used
        TIMESTAMP created_at
    }

    %% =====================================================================
    %% PASSWORD RESET TOKENS
    %% =====================================================================
    password_reset_tokens {
        UUID id PK
        UUID user_id FK
        VARCHAR token UK
        TIMESTAMP expires_at
        BOOLEAN used
        TIMESTAMP created_at
    }

    %% --- Email / Password tokens ---
    %% 1 user co the co nhieu token xac thuc email (gui lai nhieu lan)
    users ||--o{ email_verification_tokens : "verifies with"

    %% 1 user co the co nhieu token dat lai mat khau
    users ||--o{ password_reset_tokens : "resets password with"
